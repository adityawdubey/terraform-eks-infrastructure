# AWS

aws_region = "ap-south-1"

# VPC

vpc_name = "eks-vpc"
azs      = ["ap-south-1a", "ap-south-1b", "ap-south-1c"]

# EKS

cluster_name = "eks-cluster"

# Optional overrides (defaults shown)

# kubernetes_version  = "1.35"
# node_instance_types = ["m7i-flex.large"]
# node_desired_size   = 2
# node_min_size       = 2
# node_max_size       = 4

# IAM principals that get cluster admin access, besides the identity running Terraform (do not include that identity)
# cluster_admin_principal_arns = ["arn:aws:iam::<account-id>:role/<admin-role>"]
